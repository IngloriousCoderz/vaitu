{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client", "vite-plugin-pwa/vanillajs"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.js", "src/testing"]
}
