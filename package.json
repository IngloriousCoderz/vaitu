{
  "name": "vaitu",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Pass on the jobs you can't take, and find the ones you can",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck": "node scripts/typecheck.mjs",
    "lint-staged": "lint-staged",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "security:scan": "node scripts/security-scan.mjs",
    "dev": "vite",
    "edge": "supabase functions serve",
    "edge:check": "cd supabase/functions && deno check */index.ts && deno lint",
    "vault:push": "node scripts/push-vault-secrets.mjs",
    "secrets:push": "node scripts/push-function-secrets.mjs",
    "taxonomy:snippet": "node scripts/job-taxonomy-snippet.mjs",
    "build": "vite build",
    "build:release": "inglorious-live-update build",
    "landing": "pnpm --dir landing dev",
    "preview": "vite preview",
    "cap": "cap",
    "mobile:init:ios": "cap add ios && inglorious-capacitor assets --ios",
    "mobile:init:android": "cap add android && inglorious-capacitor assets --android",
    "mobile:sync": "pnpm build && cap sync",
    "mobile:ios": "pnpm build && cap run ios",
    "mobile:android": "pnpm build && cap run android",
    "mobile:ios:dev": "CAP_LIVE=1 cap run ios",
    "mobile:android:dev": "CAP_LIVE=1 cap run android",
    "mobile:release": "node scripts/native-version.mjs && pnpm build:release && cap sync",
    "mobile:assets": "inglorious-capacitor assets",
    "capacitor:sync:after": "inglorious-capacitor configure",
    "changeset": "changeset",
    "release:version": "changeset version",
    "live:keys": "inglorious-live-update keys",
    "live:release": "inglorious-live-update release",
    "prepare": "husky"
  },
  "liveUpdate": {
    "minBuild": 3
  },
  "native": {
    "appLinks": {
      "domain": "app.vaitu.net",
      "paths": [
        "/",
        "/jobs*",
        "/applications*",
        "/notifications*",
        "/profile*",
        "/preferences*",
        "/ranks*"
      ],
      "exclude": [
        "#*access_token*",
        "/onboarding*",
        "/unsubscribe*"
      ]
    },
    "ios": {
      "teamId": "55926AF5G4",
      "swipeBack": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Vaitu uses the microphone to record the voice message that fills in your job."
      }
    },
    "android": {
      "sha256": [
        "C1:0B:65:58:71:EE:9F:A8:95:D0:1C:7B:54:60:4C:9D:66:21:56:28:84:13:8E:6A:40:18:8B:D6:D2:C1:58:07",
        "7C:11:7C:C4:65:C7:8C:AF:59:8F:B5:C6:61:E7:C3:47:23:95:57:DE:81:47:CF:E1:D7:DA:D4:00:93:14:9F:77"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "assets": {
      "background": "#f6f3ea",
      "backgroundDark": "#2b2b26",
      "iconScale": 0.75
    }
  },
  "dependencies": {
    "@capacitor-firebase/analytics": "^8.6.0",
    "@capacitor-firebase/messaging": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-live-update": "^8.8.1",
    "@iconify-icons/material-symbols": "^2.0.8",
    "@inglorious/firebase": "^0.1.1",
    "@inglorious/i18n": "^2.1.0",
    "@inglorious/motion": "^9.0.18",
    "@inglorious/store": "^12.3.0",
    "@inglorious/supabase": "^0.8.0",
    "@inglorious/ui": "^9.19.0",
    "@inglorious/utils": "^5.1.0",
    "@inglorious/web": "^6.22.0",
    "@supabase/supabase-js": "^2.119.0",
    "firebase": "^13.2.0",
    "fix-webm-duration": "^1.0.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@changesets/cli": "^3.0.3",
    "@inglorious/capacitor": "^0.1.1",
    "@inglorious/eslint-config": "^1.2.0",
    "@inglorious/vite-plugin-hmr": "^1.1.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup-plugin-minify-template-literals": "^2.2.0",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">= 26"
  }
}
