{
  "name": "vaitu",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Find wedding work",
  "author": "",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "test:watch": "vitest",
    "test": "vitest run",
    "dev": "vite",
    "edge": "supabase functions serve",
    "build": "vite build",
    "preview": "vite preview",
    "cap": "cap",
    "mobile:init:ios": "cap add ios",
    "mobile:init:android": "cap add android",
    "mobile:sync": "pnpm build && cap sync",
    "mobile:ios": "pnpm build && cap run ios",
    "mobile:android": "pnpm build && cap run android",
    "mobile:ios:dev": "CAP_LIVE=1 cap run ios",
    "mobile:android:dev": "CAP_LIVE=1 cap run android",
    "assets:compose": "node scripts/compose-logo-assets.mjs",
    "assets": "pnpm assets:compose && capacitor-assets generate --ios --android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@iconify-icons/material-symbols": "^2.0.6",
    "@inglorious/i18n": "^1.2.0",
    "@inglorious/motion": "^9.0.6",
    "@inglorious/store": "^11.0.3",
    "@inglorious/ui": "^8.0.0",
    "@inglorious/web": "^6.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "fix-webm-duration": "^1.0.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@inglorious/eslint-config": "^1.1.2",
    "@inglorious/vite-plugin-hmr": "^1.0.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "rollup-plugin-minify-template-literals": "^2.2.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">= 22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
