{
  "name": "vaitu",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Find wedding work",
  "author": "",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "dev": "vite",
    "edge": "supabase functions serve",
    "build": "vite build",
    "preview": "vite preview",
    "cap": "cap",
    "mobile:init:ios": "cap add ios",
    "mobile:init:android": "cap add android",
    "mobile:sync": "pnpm build && cap sync",
    "mobile:ios": "pnpm build && cap run ios",
    "mobile:android": "pnpm build && cap run android",
    "mobile:ios:dev": "CAP_LIVE=1 cap run ios",
    "mobile:android:dev": "CAP_LIVE=1 cap run android",
    "assets:compose": "node scripts/compose-logo-assets.mjs",
    "assets": "pnpm assets:compose && capacitor-assets generate --ios --android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/share": "^8.0.3",
    "@inglorious/motion": "^9.0.2",
    "@inglorious/store": "^11.0.1",
    "@inglorious/ui": "^7.1.4",
    "@inglorious/web": "^6.4.1",
    "@supabase/supabase-js": "^2.117.2",
    "fix-webm-duration": "^1.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@inglorious/eslint-config": "^1.1.2",
    "@inglorious/vite-plugin-hmr": "^1.0.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "rollup-plugin-minify-template-literals": "^2.2.0",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">= 22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
