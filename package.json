{
  "name": "vaitu",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Pass on the jobs you can't take, and find the ones you can",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck": "node scripts/typecheck.mjs",
    "lint-staged": "lint-staged",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "security:scan": "node scripts/security-scan.mjs",
    "dev": "vite",
    "edge": "supabase functions serve",
    "edge:check": "cd supabase/functions && deno check */index.ts && deno lint",
    "vault:push": "node scripts/push-vault-secrets.mjs",
    "secrets:push": "node scripts/push-function-secrets.mjs",
    "build": "vite build",
    "build:release": "inglorious-live-update build",
    "landing": "pnpm --dir landing dev",
    "preview": "vite preview",
    "cap": "cap",
    "mobile:init:ios": "cap add ios",
    "mobile:init:android": "cap add android",
    "mobile:sync": "pnpm build && cap sync",
    "mobile:ios": "pnpm build && cap run ios",
    "mobile:android": "pnpm build && cap run android",
    "mobile:ios:dev": "CAP_LIVE=1 cap run ios",
    "mobile:android:dev": "CAP_LIVE=1 cap run android",
    "mobile:release": "node scripts/native-version.mjs && pnpm build:release && cap sync",
    "changeset": "changeset",
    "release:version": "changeset version",
    "live:keys": "inglorious-live-update keys",
    "live:release": "inglorious-live-update release",
    "assets:compose": "node scripts/compose-logo-assets.mjs",
    "assets": "pnpm assets:compose && capacitor-assets generate --ios --android",
    "prepare": "husky"
  },
  "liveUpdate": {
    "minBuild": 3
  },
  "dependencies": {
    "@capacitor-firebase/analytics": "^8.6.0",
    "@capacitor-firebase/messaging": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-live-update": "^8.8.1",
    "@iconify-icons/material-symbols": "^2.0.8",
    "@inglorious/firebase": "^0.1.1",
    "@inglorious/i18n": "^2.0.0",
    "@inglorious/motion": "^9.0.18",
    "@inglorious/store": "^12.3.0",
    "@inglorious/supabase": "^0.7.0",
    "@inglorious/ui": "^9.18.2",
    "@inglorious/utils": "^5.1.0",
    "@inglorious/web": "^6.20.0",
    "@supabase/supabase-js": "^2.119.0",
    "firebase": "^13.2.0",
    "fix-webm-duration": "^1.0.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@changesets/cli": "^3.0.3",
    "@inglorious/eslint-config": "^1.2.0",
    "@inglorious/vite-plugin-hmr": "^1.1.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup-plugin-minify-template-literals": "^2.2.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">= 26"
  }
}
