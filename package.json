{
  "name": "vaitu",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Find wedding work",
  "author": "",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "lint-staged": "lint-staged",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "dev": "vite",
    "edge": "supabase functions serve",
    "edge:check": "cd supabase/functions && deno check */index.ts && deno lint",
    "build": "vite build",
    "preview": "vite preview",
    "cap": "cap",
    "mobile:init:ios": "cap add ios",
    "mobile:init:android": "cap add android",
    "mobile:sync": "pnpm build && cap sync",
    "mobile:ios": "pnpm build && cap run ios",
    "mobile:android": "pnpm build && cap run android",
    "mobile:ios:dev": "CAP_LIVE=1 cap run ios",
    "mobile:android:dev": "CAP_LIVE=1 cap run android",
    "assets:compose": "node scripts/compose-logo-assets.mjs",
    "assets": "pnpm assets:compose && capacitor-assets generate --ios --android",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@iconify-icons/material-symbols": "^2.0.7",
    "@inglorious/i18n": "^1.3.0",
    "@inglorious/motion": "^9.0.18",
    "@inglorious/store": "^12.1.1",
    "@inglorious/ui": "^9.7.3",
    "@inglorious/web": "^6.10.2",
    "@supabase/supabase-js": "^2.118.0",
    "fix-webm-duration": "^1.0.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@inglorious/eslint-config": "^1.2.0",
    "@inglorious/vite-plugin-hmr": "^1.1.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup-plugin-minify-template-literals": "^2.2.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">= 22"
  }
}
